# Postgres connection string.
# Matches the local database in docker-compose.yml (`pnpm db:up`).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zakat?schema=public"

# Helius API key, used to read balances for a scanned address — today's from the
# DAS API, and each past hawl's from the archive (`balance-at`, 100 credits a
# read, one holding at a time, so rebuilding history is the expensive part).
# Free tier at https://dashboard.helius.dev — 1M credits/month is ample here.
# Server-side only: it is read in src/lib/helius.ts and never sent to the browser.
HELIUS_API_KEY=""

# Past hawls are priced against DefiLlama, which needs no key and is keyed by
# mint address — see src/lib/defillama.ts. Nothing to configure here.

# Where payment for earlier years lands. Public by necessity: a payer's wallet
# has to be told the recipient, so this ships to the browser and every payment
# to it is on-chain and permanent. Use an account kept for this and nothing else.
NEXT_PUBLIC_TREASURY_ADDRESS=""
